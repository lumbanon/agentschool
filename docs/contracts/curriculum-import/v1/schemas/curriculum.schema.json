{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentschool.local/contracts/curriculum-import/v1/curriculum.schema.json",
  "title": "Curriculum structure for one subject (KSSM: chapter > content standard > learning standard)",
  "type": "object",
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "curriculum" },
    "subject": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/subjectId" },
        "spm_code": {
          "description": "SPM paper code as text, e.g. '3472' (Additional Mathematics), '1449' (Mathematics), '1511' (Science).",
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "name": { "$ref": "common.schema.json#/$defs/localizedText" }
      },
      "required": ["id", "spm_code", "name"],
      "additionalProperties": false
    },
    "framework": {
      "description": "Which official document the structure follows.",
      "type": "object",
      "properties": {
        "name": { "const": "KSSM" },
        "document": { "type": "string", "minLength": 3, "maxLength": 300 },
        "edition": { "type": "string", "maxLength": 100 },
        "source": { "$ref": "common.schema.json#/$defs/source" }
      },
      "required": ["name", "document", "source"],
      "additionalProperties": false
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "form": { "$ref": "common.schema.json#/$defs/form" },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/chapter" }
          }
        },
        "required": ["form", "chapters"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contract_version", "kind", "subject", "framework", "forms"],
  "additionalProperties": false,
  "$defs": {
    "chapter": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id", "description": "Convention: <subject>-f<form>-c<NN>, e.g. addmath-f4-c02." },
        "number": { "type": "integer", "minimum": 1, "maximum": 30 },
        "title": { "$ref": "common.schema.json#/$defs/localizedText" },
        "content_standards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentStandard" }
        }
      },
      "required": ["id", "number", "title", "content_standards"],
      "additionalProperties": false
    },
    "contentStandard": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id", "description": "Convention: <chapter-id>-cs-<code with dots as dashes>, e.g. addmath-f4-c02-cs-2-1." },
        "code": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "Standard Kandungan code, e.g. '2.1'." },
        "title": { "$ref": "common.schema.json#/$defs/localizedText" },
        "learning_standards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/learningStandard" }
        }
      },
      "required": ["id", "code", "title", "learning_standards"],
      "additionalProperties": false
    },
    "learningStandard": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id", "description": "Convention: <chapter-id>-ls-<code with dots as dashes>, e.g. addmath-f4-c02-ls-2-1-2." },
        "code": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Standard Pembelajaran code, e.g. '2.1.2'." },
        "description": { "$ref": "common.schema.json#/$defs/localizedText" }
      },
      "required": ["id", "code", "description"],
      "additionalProperties": false
    }
  }
}
